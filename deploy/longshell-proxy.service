[Unit]
Description=LongShell private bridge to loopback forwarding
Requires=longshell-relay.service
After=longshell-relay.service

[Service]
User=longshell
Group=longshell
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18084
MemoryAccounting=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
